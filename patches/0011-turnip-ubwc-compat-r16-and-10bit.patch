@@ -26,6 +26,8 @@
    FD6_UBWC_R32G32_INT,
    FD6_UBWC_R32G32B32A32_INT,
    FD6_UBWC_R32_FLOAT,
+   FD6_UBWC_R16_INT,
+   FD6_UBWC_A2B10G10R10_INT,
