+/* The formats an image created with VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT and no
+ * VkImageFormatListCreateInfo may be viewed as: every color format with the
+ * same texel block, i.e. the same number of bits per block and the same block
+ * shape.  This is the rule the spec uses for the compatibility class of an
+ * uncompressed color format ("occupies the same number of bits per texel
+ * block"), and it is deliberately a superset of it: a superset can only make
+ * the answer more conservative, and it lets the driver answer without
+ * carrying a copy of the format table.
+ *
+ * The block shape is what the tiled layout is a function of (fd6_layout.c:
+ * layout->cpp = util_format_get_blocksize()), so a format outside the block
+ * class can never describe the same memory.  What is left inside the class is
+ * the channel order, and that is what the format-list predicates already
+ * compare.
+ *
+ * Returns 0 for images whose layout is not a plain color layout (depth,
+ * stencil, multi-planar) and when the class does not fit into max; the caller
+ * then keeps the conservative "no list" answer.
+ */
+unsigned
+tu6_mutable_compat_class(VkFormat format, VkFormat *list, unsigned max)
+{
+   enum pipe_format base = vk_format_to_pipe_format(format);
+
+   if (base == PIPE_FORMAT_NONE || vk_format_get_plane_count(format) > 1 ||
+       util_format_is_depth_or_stencil(base))
+      return 0;
+
+   const struct util_format_description *base_desc =
+      util_format_description(base);
+   const bool base_compressed = util_format_is_compressed(base);
+
+   if (!base_compressed && base_desc->layout != UTIL_FORMAT_LAYOUT_PLAIN)
+      return 0;
+
+   unsigned n = 0;
+   for (unsigned p = 0; p < PIPE_FORMAT_COUNT; p++) {
+      enum pipe_format f = (enum pipe_format) p;
+      const struct util_format_description *desc;
+
+      if (f == PIPE_FORMAT_NONE || util_format_is_depth_or_stencil(f))
+         continue;
+
+      /* Only a format the driver can actually use can be a view of this
+       * image; the rest would only make the answer more conservative than it
+       * has to be.  A view is either sampled or written, and block-compressed
+       * formats are texture-only (fd6_format_table.c: _T_ has rb = NONE), so
+       * both sides have to be consulted.
+       */
+      if (fd6_color_format(f, TILE6_LINEAR) == FMT6_NONE &&
+          fd6_texture_format(f, TILE6_LINEAR, false) == FMT6_NONE)
+         continue;
+
+      desc = util_format_description(f);
+      if (!desc)
+         continue;
+
+      if (util_format_is_compressed(f) != base_compressed ||
+          desc->block.bits != base_desc->block.bits ||
+          desc->block.width != base_desc->block.width ||
+          desc->block.height != base_desc->block.height)
+         continue;
+
+      VkFormat vk_format = vk_format_from_pipe_format(f);
+      if (vk_format == VK_FORMAT_UNDEFINED)
+         continue;
+
+      if (n == max)
+         return 0;
+
+      list[n++] = vk_format;
+   }
+
+   return n;
+}
+
+/* Bound the question by the compatibility class when the app passed no list,
+ * so that the format query and vkCreateImage agree: an image which keeps the
+ * tiled layout may be created, one which would be demoted to linear is
+ * refused by both.
+ */
+static const VkImageFormatListCreateInfo *
+tu_mutable_format_list_or_class(VkFormat format,
+                                const VkImageFormatListCreateInfo *fmt_list,
+                                VkFormat *compat_list, unsigned compat_max,
+                                VkImageFormatListCreateInfo *compat_info)
+{
+   if (fmt_list)
+      return fmt_list;
+
+   unsigned n = tu6_mutable_compat_class(format, compat_list, compat_max);
+   if (!n)
+      return NULL;
+
+   compat_info->sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO;
+   compat_info->pNext = NULL;
+   compat_info->viewFormatCount = n;
+   compat_info->pViewFormats = compat_list;
+
+   return compat_info;
+}
+
