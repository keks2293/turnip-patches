                                       VkFormat format,
                                       const VkImageFormatListCreateInfo *fmt_list)
 {
+   VkFormat compat_list[64];
+   VkImageFormatListCreateInfo compat_info;
+
+   fmt_list = tu_mutable_format_list_or_class(format, fmt_list, compat_list,
+                                              ARRAY_SIZE(compat_list),
+                                              &compat_info);
+
    /* A list we already consider compatible keeps the tiled layout. */
    if (tu6_mutable_format_list_ubwc_compatible(info, fmt_list))
       return false;
