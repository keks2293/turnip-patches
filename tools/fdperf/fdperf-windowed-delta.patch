+       * the real CP timestamp delta, so the % is meaningful too.
+       */
+      uint64_t start_time = gettime_us();
+      uint64_t timeout_us = (uint64_t)(options.refresh_ms * 5 + 5000) * 1000;
+
+      while (dev.samples_read < 2) {
+         resample_perfcntr_stream();
+         if (dev.samples_read >= 2)
+            break;
+         usleep(10000);
+         if (dev.samples_read == 0 &&
+             gettime_us() - start_time > timeout_us) {
+            fprintf(stderr, "fdperf: no kernel samples after %u s\n",
+                    (unsigned)((gettime_us() - start_time) / 1000000));
+            break;
+         }
+      }
