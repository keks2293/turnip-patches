@@ -640,3 +640,101 @@ tu_dbg_log_gmem_load_store_skips(struct tu_device *device)
 
    pthread_mutex_unlock(&device->submit_mutex);
 }
+
+/* Render-mode verdict histogram, see the declaration in tu_util.h.  The reason
+ * strings are literals owned by the driver, so the table stores the pointer and
+ * compares it by identity: no copies, no allocation, no lifetime question.
+ */
+#define TU_DBG_RM_MAX_REASONS 32
+
+struct tu_dbg_rm_entry {
+   const char *reason;
+   bool sysmem;
+   uint32_t count;
+   uint32_t binned;
+};
+
+static pthread_mutex_t tu_dbg_rm_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct tu_dbg_rm_entry tu_dbg_rm_entries[TU_DBG_RM_MAX_REASONS];
+static unsigned tu_dbg_rm_num_entries;
+static uint32_t tu_dbg_rm_passes, tu_dbg_rm_sysmem, tu_dbg_rm_gmem, tu_dbg_rm_binned;
+
+static bool
+tu_dbg_rm_hist_enabled(void)
+{
+   static int enabled = -1;
+
+   if (enabled < 0)
+      enabled = os_get_option("TU_DBG_RM_HIST") != NULL;
+
+   return enabled != 0;
+}
+
+void
+tu_dbg_note_render_mode(bool sysmem, bool binned, const char *reason)
+{
+   if (!tu_dbg_rm_hist_enabled())
+      return;
+
+   pthread_mutex_lock(&tu_dbg_rm_lock);
+
+   tu_dbg_rm_passes++;
+   if (sysmem)
+      tu_dbg_rm_sysmem++;
+   else
+      tu_dbg_rm_gmem++;
+   if (binned)
+      tu_dbg_rm_binned++;
+
+   for (unsigned i = 0; i < tu_dbg_rm_num_entries; i++) {
+      if (tu_dbg_rm_entries[i].reason == reason &&
+          tu_dbg_rm_entries[i].sysmem == sysmem) {
+         tu_dbg_rm_entries[i].count++;
+         if (binned)
+            tu_dbg_rm_entries[i].binned++;
+         pthread_mutex_unlock(&tu_dbg_rm_lock);
+         return;
+      }
+   }
+
+   if (tu_dbg_rm_num_entries < TU_DBG_RM_MAX_REASONS) {
+      struct tu_dbg_rm_entry *e = &tu_dbg_rm_entries[tu_dbg_rm_num_entries++];
+      e->reason = reason;
+      e->sysmem = sysmem;
+      e->binned = binned ? 1 : 0;
+      e->count = 1;
+   }
+
+   pthread_mutex_unlock(&tu_dbg_rm_lock);
+}
+
+void
+tu_dbg_log_render_mode_histogram(void)
+{
+   static struct timespec last_time = {};
+
+   if (!tu_dbg_rm_hist_enabled())
+      return;
+
+   struct timespec current_time;
+   clock_gettime(CLOCK_MONOTONIC, &current_time);
+   if (timespec_sub_to_nsec(&current_time, &last_time) < 1000 * 1000 * 1000)
+      return;
+   last_time = current_time;
+
+   pthread_mutex_lock(&tu_dbg_rm_lock);
+
+   mesa_logi("[RM] passes: %u sysmem: %u gmem: %u binned: %u\n",
+             tu_dbg_rm_passes, tu_dbg_rm_sysmem, tu_dbg_rm_gmem,
+             tu_dbg_rm_binned);
+   for (unsigned i = 0; i < tu_dbg_rm_num_entries; i++) {
+      const struct tu_dbg_rm_entry *e = &tu_dbg_rm_entries[i];
+      mesa_logi("[RM]   %-6s %5u  binned %5u  %s\n", e->sysmem ? "sysmem" : "gmem",
+                e->count, e->binned, e->reason ? e->reason : "(no reason)");
+   }
+
+   tu_dbg_rm_passes = tu_dbg_rm_sysmem = tu_dbg_rm_gmem = tu_dbg_rm_binned = 0;
+   tu_dbg_rm_num_entries = 0;
+
+   pthread_mutex_unlock(&tu_dbg_rm_lock);
+}
