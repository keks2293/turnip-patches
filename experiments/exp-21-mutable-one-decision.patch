+/* The formats an image created with VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT and no
+ * VkImageFormatListCreateInfo may still be viewed as: every color format with
+ * the same texel block, i.e. the same number of bits per block and the same
+ * block shape.  That is the rule the spec uses for the compatibility class of
+ * an uncompressed color format ("occupies the same number of bits per texel
+ * block"), and here it is deliberately a superset of it: a superset can only
+ * make the answer more conservative, and it lets the driver answer without
+ * carrying a copy of the format table.
+ *
+ * The block is what the question is asked about: the tiled layout is a
+ * function of it (fd6_layout.c: layout->cpp = util_format_get_blocksize()), so
+ * a format outside the block class can never describe the same memory.  What
+ * is left inside the class is the channel order, which is exactly what
+ * tu6_format_list_has_swaps() and tu6_format_list_swaps_are_uniform() compare.
+ *
+ * Only formats the driver can actually use are counted.  A view is either
+ * sampled or written, and block-compressed formats are texture-only in
+ * fd6_format_table.c (_T_ leaves rb = NONE), so both tables have to be
+ * consulted: with fd6_color_format() alone every BC format drops out of its
+ * own class and BC loses the tiling for no reason.
+ *
+ * Returns 0 when the base format has no layout of its own (depth, stencil,
+ * multi-planar) and when the class does not fit into max; the caller then keeps
+ * the conservative answer which is given for a missing list.
+ */
+static unsigned
+mutable_compat_class(VkFormat format, VkFormat *list, unsigned max)
+{
+   enum pipe_format base = vk_format_to_pipe_format(format);
+
+   if (base == PIPE_FORMAT_NONE || vk_format_get_plane_count(format) > 1 ||
+       util_format_is_depth_or_stencil(base))
+      return 0;
+
+   const struct util_format_description *base_desc =
+      util_format_description(base);
+   const bool base_compressed = util_format_is_compressed(base);
+
+   if (!base_compressed && base_desc->layout != UTIL_FORMAT_LAYOUT_PLAIN)
+      return 0;
+
+   unsigned n = 0;
+   for (unsigned p = 0; p < PIPE_FORMAT_COUNT; p++) {
+      enum pipe_format f = (enum pipe_format) p;
+      const struct util_format_description *desc;
+
+      if (f == PIPE_FORMAT_NONE || util_format_is_depth_or_stencil(f))
+         continue;
+
+      if (fd6_color_format(f, TILE6_LINEAR) == FMT6_NONE &&
+          fd6_texture_format(f, TILE6_LINEAR, false) == FMT6_NONE)
+         continue;
+
+      desc = util_format_description(f);
+      if (!desc)
+         continue;
+
+      if (util_format_is_compressed(f) != base_compressed ||
+          desc->block.bits != base_desc->block.bits ||
+          desc->block.width != base_desc->block.width ||
+          desc->block.height != base_desc->block.height)
+         continue;
+
+      VkFormat vk_format = vk_format_from_pipe_format(f);
+      if (vk_format == VK_FORMAT_UNDEFINED)
+         continue;
+
+      if (n == max)
+         return 0;
+
+      list[n++] = vk_format;
+   }
+
+   return n;
+}
+
+/* The formats whose layout an image has to describe: the list the application
+ * passed, or the compatibility class of its base format when it passed none.
+ * NULL when neither answers the question, which is the worst case the
+ * predicates were written for.
+ *
+ * The compression is not asked here: it is a property of the format that is
+ * actually used, so an image without a list has no answer and loses UBWC
+ * whichever class its base format belongs to.  Only the layout is a property
+ * of the block, and therefore decidable without the list.
+ */
+static const VkImageFormatListCreateInfo *
+mutable_views(VkFormat format, const VkImageFormatListCreateInfo *fmt_list,
+              VkFormat *compat_list, unsigned compat_max,
+              VkImageFormatListCreateInfo *compat_info)
+{
+   if (fmt_list)
+      return fmt_list;
+
+   unsigned n = mutable_compat_class(format, compat_list, compat_max);
+   if (!n)
+      return NULL;
+
+   compat_info->sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO;
+   compat_info->pNext = NULL;
+   compat_info->viewFormatCount = n;
+   compat_info->pViewFormats = compat_list;
+
+   return compat_info;
+}
