+static bool
+tu_image_exp23_nolist_64bit(const VkImageCreateInfo *pCreateInfo,
+                            const VkImageFormatListCreateInfo *fmt_list)
+{
+   if (!getenv("TU_UBWC_NOLIST_64"))
+      return false;
+
+   if (fmt_list && fmt_list->viewFormatCount)
+      return false;
+
+   return util_format_get_blocksize(
+             vk_format_to_pipe_format(pCreateInfo->format)) == 8;
+}
